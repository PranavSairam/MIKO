# Optional local env for packaging. Copy to beta/.env.local (gitignored).
# Zero-budget beta does NOT require Apple, VPS, or paid hosting.
#
#   set -a && source beta/.env.local && set +a

# Shared DMG / folder link baked into Download latest version:
MIKO_MANUAL_RELEASE_URL=https://www.dropbox.com/scl/fi/EXAMPLE/MIKO.dmg?dl=1

# Optional version manifest next to the DMG (see beta/latest.json.example):
# MIKO_LATEST_JSON_URL=https://www.dropbox.com/scl/fi/EXAMPLE/latest.json?dl=1

# --- Later only (signed auto-update + hosted feedback) — not required now ---
# MIKO_SIGN=1
# CSC_LINK=
# CSC_KEY_PASSWORD=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
# MIKO_UPDATE_URL=https://…
# MIKO_FEEDBACK_URL=https://…/v1/reports
